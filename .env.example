# Copiá este archivo a .env.local y completá con los datos del proyecto Supabase
# (Project Settings > API). Nunca commitees credenciales reales.
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-publica

# Solo desarrollo: carga pacientes/turnos ficticios al iniciar.
# Se ignora en el build de producción aunque esté en "true".
VITE_USAR_SEED=false
